<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg_0">

  <!-- Header: logo + goal title on the left, streak on the right -->
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
      android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="Morning run" android:textColor="#292522" android:textStyle="bold" android:textSize="20sp"
        android:maxLines="1" android:ellipsize="end" android:paddingEnd="8dp" />
    <TextView android:id="@+id/widget_streak_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🔥" android:textSize="20sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_streak_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="12" android:textColor="#C94D55" android:textStyle="bold" android:textSize="24sp" android:paddingStart="3dp" />
    <TextView android:id="@+id/widget_streak_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="days" android:textColor="#654C45" android:textSize="12sp" android:paddingStart="3dp" />
  </LinearLayout>

  <!-- Middle block takes the spare height and centres itself, so extra room becomes even breathing space -->
  <LinearLayout android:orientation="vertical" android:gravity="center_vertical"
      android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:orientation="horizontal" android:gravity="bottom"
        android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView android:id="@+id/widget_countdown_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="45" android:textColor="#292522" android:textStyle="bold" android:textSize="38sp" android:maxLines="1" />
      <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="days left" android:textColor="#654C45" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_target" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="by Dec 31, 2026" android:textColor="#9A857B" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress_0" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:max="100" android:progress="40" android:indeterminate="false"
        android:progressDrawable="@drawable/widget_progress_0" />
    <ProgressBar android:visibility="gone" android:id="@+id/widget_progress_1" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:max="100" android:progress="40" android:indeterminate="false"
        android:progressDrawable="@drawable/widget_progress_1" />
    <ProgressBar android:visibility="gone" android:id="@+id/widget_progress_2" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:max="100" android:progress="40" android:indeterminate="false"
        android:progressDrawable="@drawable/widget_progress_2" />
    <ProgressBar android:visibility="gone" android:id="@+id/widget_progress_3" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:max="100" android:progress="40" android:indeterminate="false"
        android:progressDrawable="@drawable/widget_progress_3" />
    <ProgressBar android:visibility="gone" android:id="@+id/widget_progress_4" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:max="100" android:progress="40" android:indeterminate="false"
        android:progressDrawable="@drawable/widget_progress_4" />
  </LinearLayout>

  <Button android:id="@+id/widget_checkin" android:layout_width="match_parent" android:layout_height="44dp"
      android:text="Check In" android:textColor="#713E31" android:textStyle="bold" android:textAllCaps="false"
      android:textSize="15sp" android:background="@drawable/widget_button_background" />
</LinearLayout>
